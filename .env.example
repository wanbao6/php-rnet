# Copy this file to .env and adjust paths for your system.
# .env is gitignored — never commit it.

# Path to cmake binary directory
# Example: /usr/bin  or  /home/you/.local/share/mise/installs/cmake/4.2.3/bin
CMAKE_BIN=/usr/bin

# Path to the directory containing libclang.so
# Example: /usr/lib/llvm-18/lib
LIBCLANG_PATH=/usr/lib/llvm-18/lib

# Extra lib directories needed to load libclang at runtime
# Usually the same as LIBCLANG_PATH, sometimes also needs x86_64-linux-gnu
# Separate multiple paths with :
LD_LIBRARY_PATH_EXTRA=/usr/lib/llvm-18/lib

# Path to the php-config binary for your target PHP version
# Example: /usr/bin/php-config  or  /usr/bin/php-config8.4
PHP_CONFIG=/usr/bin/php-config

# Path to the php CLI binary
PHP=/usr/bin/php

# Extra clang args for bindgen (usually needed when using a non-system clang)
# Leave empty if libclang was installed via apt to a standard location
BINDGEN_EXTRA_CLANG_ARGS=
